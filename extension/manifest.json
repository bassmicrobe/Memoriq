{
  "manifest_version": 3,
  "name": "Memoriq",
  "version": "0.1.0",
  "description": "許可したサイトの未使用タブを休止し、Macのメモリを確認します。",
  "minimum_chrome_version": "121",
  "key": "",
  "permissions": [
    "tabs",
    "storage",
    "alarms",
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_title": "Memoriq",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
